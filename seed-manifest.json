{
  "schema": "pramaan/provider-update-demo-seed/v1",
  "repository": {
    "owner": "Pramaan-Dev",
    "name": "provider-update-demo-razorpay",
    "remote": "https://github.com/Pramaan-Dev/provider-update-demo-razorpay.git",
    "baseRef": "main",
    "headPattern": "product-loop/live-demo-*"
  },
  "baseline": {
    "dependencies": {
      "@biomejs/biome": "1.9.4",
      "@types/node": "22.5.4",
      "dayjs": "1.11.11",
      "razorpay": "2.9.0",
      "typescript": "5.5.4",
      "zod": "3.23.8"
    },
    "node": "24.18.0",
    "packageManager": "pnpm@11.15.1",
    "verificationCommand": "pnpm test",
    "testPaths": [
      "tests/draft-invoice.test.ts",
      "tests/refund-status.test.ts",
      "tests/settle-payment.test.ts",
      "tests/verify-signature.test.ts"
    ]
  },
  "expectedUpdate": {
    "hero": "razorpay upgrade to 2.9.8-era current release",
